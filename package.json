{
  "name": "sideloadx",
  "version": "1.0.0",
  "description": "All-in-One iOS App Sideloading Tool - Like AltStore, Sideloadly & SideStore combined",
  "main": "src/main/index.js",
  "author": {
    "name": "SideloadX",
    "email": "sideloadx@users.noreply.github.com"
  },
  "license": "MIT",
  "scripts": {
    "dev": "vite --config vite.config.js & sleep 2 && electron .",
    "dev:web": "vite --config vite.config.js",
    "build:web": "vite build --config vite.config.js",
    "build:mac": "vite build --config vite.config.js && electron-builder --mac --arm64 --x64",
    "build:win": "vite build --config vite.config.js && electron-builder --win --x64 --arm64",
    "build:linux": "vite build --config vite.config.js && electron-builder --linux --x64 --arm64",
    "build:all": "vite build --config vite.config.js && electron-builder --mac --win --linux --arm64 --x64",
    "build:mac:arm64": "vite build --config vite.config.js && electron-builder --mac --arm64",
    "build:mac:x64": "vite build --config vite.config.js && electron-builder --mac --x64",
    "build:win:x64": "vite build --config vite.config.js && electron-builder --win --x64",
    "build:linux:x64": "vite build --config vite.config.js && electron-builder --linux --x64"
  },
  "dependencies": {
    "adm-zip": "^0.5.10",
    "clsx": "^2.1.0",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "framer-motion": "^10.18.0",
    "lucide-react": "^0.303.0",
    "node-forge": "^1.3.1",
    "plist": "^3.1.0",
    "selfsigned": "^2.4.1",
    "sql.js": "^1.10.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "electron": "^28.1.0",
    "electron-builder": "^26.15.3",
    "electron-updater": "^6.8.9",
    "postcss": "^8.4.32",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwindcss": "^3.4.0",
    "vite": "^5.0.10"
  },
  "build": {
    "appId": "com.sideloadx.app",
    "productName": "SideloadX",
    "copyright": "Copyright © 2026 SideloadX",
    "afterSign": null,
    "asar": true,
    "files": [
      "src/main/**/*",
      "src/preload/**/*",
      "dist/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        { "target": "dmg", "arch": ["arm64", "x64"] },
        { "target": "zip", "arch": ["arm64", "x64"] }
      ],
      "icon": "build/icon.icns",
      "identity": null,
      "hardenedRuntime": false
    },
    "dmg": {
      "title": "SideloadX ${version}",
      "contents": [
        { "x": 130, "y": 220 },
        { "x": 410, "y": 220, "type": "link", "path": "/Applications" }
      ]
    },
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64", "arm64"] },
        { "target": "portable", "arch": ["x64"] }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SideloadX"
    },
    "linux": {
      "target": [
        { "target": "AppImage", "arch": ["x64", "arm64"] },
        { "target": "deb", "arch": ["x64"] }
      ],
      "icon": "build/icon.png",
      "category": "Development",
      "synopsis": "All-in-One iOS App Sideloading Tool"
    }
  }
}
